# Server Configuration
PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3307
DB_USER=root
DB_PASSWORD=your_secure_db_password_here
DB_NAME=odst_airlines

# JWT Security
JWT_SECRET=your_super_secret_jwt_random_key_production
JWT_EXPIRES_IN=7d

# Default Admin Seed (Auto-created on first database initialization)
ADMIN_DEFAULT_EMAIL=admin@yourdomain.com
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=your_strong_admin_password_here

# Allowed CORS Origins (comma separated or *)
CORS_ORIGIN=*
