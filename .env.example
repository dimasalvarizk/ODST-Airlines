# =================================================================
# ODST AIRLINES - DOCKER & ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to .env on your VPS / Coolify and fill with your secrets.
# =================================================================

# MySQL Database in Docker
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
DB_NAME=odst_airlines
DB_USER=odst_user
DB_PASSWORD=your_secure_db_password_here
DB_PORT=3306

# Backend Configuration
BACKEND_PORT=5000
JWT_SECRET=your_super_secret_jwt_random_key_production
JWT_EXPIRES_IN=7d
ADMIN_DEFAULT_EMAIL=admin@yourdomain.com
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=your_strong_admin_password_here

# Frontend Configuration
FRONTEND_PORT=3000
PORT=3000

# Mailchimp Integration (Optional)
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=us11
MAILCHIMP_AUDIENCE_ID=
