# =================================================================
# ODST AIRLINES - ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env for local development or input these
# keys into Coolify / Hostinger VPS Environment Variables dashboard.
# =================================================================

# Mailchimp API Integration (Newsletter & Launch Alerts)
MAILCHIMP_API_KEY=your_mailchimp_api_key_here
MAILCHIMP_SERVER_PREFIX=us11
MAILCHIMP_AUDIENCE_ID=your_audience_list_id_here

# Server Port (Coolify default: 3000 or 80)
PORT=3000
